# J.A.R.V.I.S. Configuration
# Obtain your free Gemini API key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Server Settings
HOST=127.0.0.1
PORT=8000

# Model Settings
# Recommended: gemini-2.5-flash or gemini-1.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Default City for Weather Queries
DEFAULT_CITY=London
